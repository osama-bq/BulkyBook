@using BulkyBook.Utility
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BulkyBook</title>
    <script type="importmap"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
          crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" rel="stylesheet"
          crossorigin="anonymous" asp-append-version="true">
    <link rel="stylesheet" href="https://cdn.datatables.net/v/dt/dt-3.1.5/datatables.min.css" asp-append-version="true">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BulkyBook.styles.css" asp-append-version="true" />
</head>

<body>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-md navbar-light bg-white shadow-sm py-2 mb-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2 p-0" asp-area=""
                   asp-controller="Home" asp-action="Index">
                    <img src="/images/book.png" alt="BulkyBook logo" width="64" height="64"
                         class="rounded-3" />
                    <span class="fs-4 fw-bold text-primary" style="letter-spacing:-0.02em">
                        Bulky<span class="text-warning">Book</span>
                    </span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse"
                        data-bs-target="#navbarMain" aria-controls="navbarMain"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto gap-md-1 py-2 py-md-0">
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-medium px-3"
                               asp-area="Customer" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark fw-medium px-3"
                                   asp-area="Admin" asp-controller="Order" asp-action="Index">
                                    <i class="bi bi-box-seam me-1"></i>My Orders
                                </a>
                            </li>
                        }
                        @if (User.IsInRole(SD.RoleAdmin) || User.IsInRole(SD.RoleEmployee))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark fw-medium px-3"
                                   asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1"></i> Admin Portal
                                </a>
                            </li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-3 py-2 py-md-0">
                        <a asp-area="Customer" asp-controller="Cart" asp-action="Index"
                           class="cart-btn text-decoration-none d-none d-lg-flex align-items-center gap-2 px-3 py-2"
                           style="background: rgba(15, 23, 42, 0.04); border-radius: 50px; border: 1px solid rgba(15, 23, 42, 0.12);">
                            <div class="cart-icon-circle d-flex align-items-center justify-content-center rounded-circle"
                                 style="width: 32px; height: 32px; background: rgba(15, 23, 42, 0.1); transition: all 0.3s ease;">
                                <i class="bi bi-cart2" style="font-size: 1rem; color: #1f2937;"></i>
                            </div>
                            <div class="d-flex flex-column" style="line-height: 1.2;">
                                <span style="font-size: 0.65rem; color: #6b7280; text-transform: uppercase; letter-spacing: 0.5px;">Cart</span>
                                <span class="cart-count" style="font-size: 0.85rem; color: #111827; font-weight: 600; transition: all 0.3s ease;">0 Items</span>
                            </div>
                        </a>
                        <partial name="_LoginPartial"/>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            <partial name="_Notification" />
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 py-4">
                <a class="footer-brand d-inline-flex align-items-center gap-3" asp-area=""
                    asp-controller="Home" asp-action="Index">
                    <i class="bi bi-book-half fs-1"></i>
                    <div class="d-flex flex-column">
                        <span class="footer-brand-name">
                            BulkyBook
                        </span>
                        <span class="footer-slogan"> books in bulk, made simple</span>
                    </div>
                </a>
                <span class="footer-copy">&copy; 2026 BulkyBook. All rights reserved.</span>
                <div class="footer-social d-flex gap-2">
                    <a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                    <a href="#" aria-label="X / Twitter"><i class="bi bi-twitter-x"></i></a>
                    <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                    <a href="#" aria-label="GitHub"><i class="bi bi-github"></i></a>
                </div>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
            crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.datatables.net/v/dt/dt-3.1.5/datatables.min.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
