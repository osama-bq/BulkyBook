@using BulkyBook.Models

@model List<Category>
    
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <h1 class="fw-bold mb-0">
        Category List
    </h1>
    <a asp-controller="Category" asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> New Category
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="text-uppercase small text-muted">
                    <tr>
                        <th class="ps-4 py-3" scope="col">Category Name</th>
                        <th class="py-3" scope="col">Display Order</th>
                        <th class="pe-4 py-3 text-end" scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold">
                                @category.Name
                            </td>
                            <td>
                                <span class="text-primary-emphasis">@category.DisplayOrder</span>
                            </td>
                            <td class="pe-4 text-end">
                                <a asp-action="Update" asp-route-id="@category.Id" class="btn btn-sm btn-outline-success">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@category.Id" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
