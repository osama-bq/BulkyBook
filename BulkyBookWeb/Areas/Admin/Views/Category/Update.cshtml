@using BulkyBook.Models
@model Category

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <h1 class="fw-bold mb-0">
        Update Category
    </h1>
    <a asp-controller="Category" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
        <i class="bi bi-arrow-left me-1"></i> Back to List
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4">
        <form method="post" asp-controller="Category" asp-action="Update">
            <div asp-validation-summary="All" class="text-danger small mb-3"></div>
            
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-medium">Category Name</label>
                <input asp-for="Name" class="form-control" placeholder="e.g. Fiction" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="DisplayOrder" class="form-label fw-medium">Display Order</label>
                <input type="number" asp-for="DisplayOrder" class="form-control"
                       placeholder="e.g. 1" />
                <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-controller="Category" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                    Cancel
                </a>
                <button type="submit" class="btn btn-primary rounded-pill px-4">
                    <i class="bi bi-check-lg me-1"></i> Update
                </button>
            </div>
        </form>
    </div>
</div>
