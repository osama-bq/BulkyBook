@using BulkyBook.Models
@using BulkyBook.Utility
@model OrderHeader

@{
    var isCustomer = User.IsInRole(SD.RoleCustomer);
}

<div class="container-fluid py-3">
    <form method="post">
        <input asp-for="Id" hidden/>
        <div class="mb-3">
            <a asp-area="Admin" asp-controller="Order" asp-action="Index"
               class="text-decoration-none text-secondary small fw-medium d-inline-flex align-items-center gap-1">
                <i class="bi bi-arrow-left"></i> Back to orders
            </a>
        </div>

        <!-- ============================ ORDER HEADER ============================ -->
        <div class="cart-panel-header rounded-4 px-4 py-3 mb-4">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-receipt fs-2"></i>
                <div>
                    <h1 class="h4 fw-bold mb-0">Order #@Model.Id</h1>
                    <p class="mb-0 small text-warning">Placed on @Model.OrderDate.ToShortDateString()</p>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-lg-5">
                <div class="row g-5">

                    <!-- ===================== SHIPPING & TRACKING ===================== -->
                    <div class="col-lg-6">
                        <h2 class="order-section-label">Order Details</h2>
                        
                        <div class="row mb-3">
                            <label asp-for="Name" class="col-4 col-sm-3 col-form-label fw-medium text-secondary">Name</label>
                            <div class="col-8 col-sm-9">
                                <input disabled="@isCustomer" asp-for="Name" class="form-control form-control-sm" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <label asp-for="PhoneNumber" class="col-4 col-sm-3 col-form-label fw-medium text-secondary">Phone</label>
                            <div class="col-8 col-sm-9">
                                <input disabled="@isCustomer" asp-for="PhoneNumber" class="form-control form-control-sm" />
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <label asp-for="StreetAddress" class="col-4 col-sm-3 col-form-label fw-medium text-secondary">Address</label>
                            <div class="col-8 col-sm-9">
                                <input disabled="@isCustomer" asp-for="StreetAddress" class="form-control form-control-sm" />
                                <span asp-validation-for="StreetAddress" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <label asp-for="City" class="col-4 col-sm-3 col-form-label fw-medium text-secondary">City</label>
                            <div class="col-8 col-sm-9">
                                <input disabled="@isCustomer" asp-for="City" class="form-control form-control-sm" />
                                <span asp-validation-for="City" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <label asp-for="State" class="col-4 col-sm-3 col-form-label fw-medium text-secondary">State</label>
                            <div class="col-8 col-sm-9">
                                <input disabled="@isCustomer" asp-for="State" class="form-control form-control-sm" />
                                <span asp-validation-for="State" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <label asp-for="PostalCode" class="col-4 col-sm-3 col-form-label fw-medium text-secondary">Zip Code</label>
                            <div class="col-8 col-sm-9">
                                <input disabled="@isCustomer" asp-for="PostalCode" class="form-control form-control-sm" />
                                <span asp-validation-for="PostalCode" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <label asp-for="ApplicationUser.Email" class="col-4 col-sm-3 col-form-label fw-medium text-secondary">Email</label>
                            <div class="col-8 col-sm-9">
                                <input asp-for="ApplicationUser.Email" class="form-control form-control-sm" disabled />
                                <span asp-validation-for="ApplicationUser.Email" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <label asp-for="OrderDate" class="col-4 col-sm-3 col-form-label fw-medium text-secondary">Order Date</label>
                            <div class="col-8 col-sm-9">
                                <input type="text" asp-for="OrderDate" class="form-control form-control-sm" disabled value="@Model.OrderDate.ToShortDateString()" />
                                <span asp-validation-for="OrderDate" class="text-danger small"></span>
                            </div>
                        </div>

                        @if (Model.OrderStatus != SD.StatusPending && Model.OrderStatus != SD.StatusApproved)
                        {
                            <div class="row mb-3">
                                <label asp-for="Carrier" class="col-4 col-sm-3 col-form-label fw-medium text-secondary">Carrier</label>
                                <div class="col-8 col-sm-9">
                                    <input disabled="@isCustomer" asp-for="Carrier" class="form-control form-control-sm" />
                                    <span asp-validation-for="Carrier" class="text-danger small"></span>
                                </div>
                            </div>
                            
                            <div class="row mb-3">
                                <label asp-for="TrackingNumber" class="col-4 col-sm-3 col-form-label fw-medium text-secondary">Tracking</label>
                                <div class="col-8 col-sm-9">
                                    <input disabled="@isCustomer" asp-for="TrackingNumber" class="form-control form-control-sm" />
                                    <span asp-validation-for="TrackingNumber" class="text-danger small"></span>
                                </div>
                            </div>
                        }

                        @if (Model.ShippingDate != default(DateTime))
                        {
                            <div class="row mb-3">
                                <label asp-for="ShippingDate" class="col-4 col-sm-3 col-form-label fw-medium text-secondary">Shipping Date</label>
                                <div class="col-8 col-sm-9">
                                    <input disabled="@isCustomer" type="text" asp-for="ShippingDate" class="form-control form-control-sm" readonly value="@Model.ShippingDate.ToShortDateString()" />
                                    <span asp-validation-for="ShippingDate" class="text-danger small"></span>
                                </div>
                            </div>
                        }

                        @if (User.IsInRole(SD.RoleAdmin) || User.IsInRole(SD.RoleEmployee))
                        {
                            <button asp-action="UpdateOrderDetails" asp-controller="Order" type="submit" class="btn btn-primary w-100 rounded-pill mt-4">
                                Update Order Details
                            </button>
                        }
                    </div>

                    <!-- ========================= ORDER SUMMARY ========================= -->
                    <div class="col-lg-6">
                        <h2 class="order-section-label">Order Summary</h2>

                        <!-- TODO: bind order status -->
                        <span class="badge rounded-pill text-bg-dark px-3 py-2 mb-4">
                            <i class="bi bi-info-circle me-1"></i> @Model.OrderStatus
                        </span>

                        @foreach (var details in Model.OrderDetails)
                        {
                            <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                                <div>
                                    <p class="fw-semibold mb-0">@details.Product.Title</p>
                                    <small class="text-secondary">@details.Price.ToString("c") &times; @details.Count</small>
                                </div>
                                <span class="fw-semibold text-primary">@((details.Price * details.Count).ToString("c"))</span>
                            </div>
                        }
                        <!-- ====================== END DETAILS PLACEHOLDER ====================== -->

                        <div class="order-total d-flex justify-content-between align-items-center rounded-3 px-4 py-3 my-4">
                            <span class="text-uppercase small fw-semibold">Total</span>
                            <span class="fs-4 fw-bold">@Model.OrderTotal.ToString("c")</span>
                        </div>

                        @if (User.IsInRole(SD.RoleAdmin) || User.IsInRole(SD.RoleEmployee))
                        {
                            <div class="d-grid gap-2">
                                @if (Model.OrderStatus == SD.StatusApproved)
                                {
                                    <button asp-action="UpdateOrderStatus" asp-controller="Order" asp-route-status="@SD.StatusProcessing" type="submit" class="btn btn-primary rounded-pill">
                                        Start Processing
                                    </button>
                                }
                                @if (Model.OrderStatus == SD.StatusProcessing)
                                {
                                    <button asp-action="UpdateOrderStatus" asp-controller="Order" asp-route-status="@SD.StatusShipped" type="submit" onclick="return validateInput()" class="btn btn-warning rounded-pill">
                                        Ship Order
                                    </button>
                                }
                                @if (Model.OrderStatus != SD.StatusRefunded && Model.OrderStatus != SD.StatusCancelled && Model.OrderStatus != SD.StatusShipped)
                                {
                                    <button asp-action="UpdateOrderStatus" asp-controller="Order" asp-route-status="@SD.StatusCancelled" type="submit" class="btn btn-danger rounded-pill">
                                        Cancel Order
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}