@using BulkyBook.Models
@model OrderHeader

<div class="mb-3">
    <a asp-area="Admin" asp-controller="Order" asp-action="Index"
       class="text-decoration-none text-secondary small fw-medium d-inline-flex align-items-center gap-1">
        <i class="bi bi-arrow-left"></i> Back to orders
    </a>
</div>

<!-- ============================ ORDER HEADER ============================ -->
<div class="cart-panel-header rounded-4 px-4 py-3 mb-4">
    <div class="d-flex align-items-center gap-3">
        <i class="bi bi-receipt fs-2"></i>
        <div>
            <!-- TODO: bind order id and order date -->
            <h1 class="h4 fw-bold mb-0">Order #123</h1>
            <p class="mb-0 small text-warning">Placed on 01/15/2024</p>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4 p-lg-5">
        <div class="row g-5">

            <!-- ===================== SHIPPING & TRACKING ===================== -->
            <div class="col-lg-6">
                <h2 class="order-section-label">Shipping &amp; Tracking</h2>

                <!-- TODO: bind the order header fields below -->
                <dl class="row mb-0">
                    <dt class="col-4 col-sm-3 fw-medium text-secondary mb-3">Name</dt>
                    <dd class="col-8 col-sm-9 mb-3">John Doe</dd>

                    <dt class="col-4 col-sm-3 fw-medium text-secondary mb-3">Phone</dt>
                    <dd class="col-8 col-sm-9 mb-3">555-1234</dd>

                    <dt class="col-4 col-sm-3 fw-medium text-secondary mb-3">Address</dt>
                    <dd class="col-8 col-sm-9 mb-3">123 Main St</dd>

                    <dt class="col-4 col-sm-3 fw-medium text-secondary mb-3">City</dt>
                    <dd class="col-8 col-sm-9 mb-3">New York</dd>

                    <dt class="col-4 col-sm-3 fw-medium text-secondary mb-3">State</dt>
                    <dd class="col-8 col-sm-9 mb-3">NY</dd>

                    <dt class="col-4 col-sm-3 fw-medium text-secondary mb-3">Zip Code</dt>
                    <dd class="col-8 col-sm-9 mb-3">10001</dd>

                    <dt class="col-4 col-sm-3 fw-medium text-secondary mb-3">Email</dt>
                    <dd class="col-8 col-sm-9 mb-3">john@example.com</dd>

                    <dt class="col-4 col-sm-3 fw-medium text-secondary mb-3">Order Date</dt>
                    <dd class="col-8 col-sm-9 mb-3">01/15/2024</dd>

                    <dt class="col-4 col-sm-3 fw-medium text-secondary mb-3">Carrier</dt>
                    <dd class="col-8 col-sm-9 mb-3">FedEx</dd>

                    <dt class="col-4 col-sm-3 fw-medium text-secondary mb-3">Tracking</dt>
                    <dd class="col-8 col-sm-9 mb-3">1234567890</dd>

                    <dt class="col-4 col-sm-3 fw-medium text-secondary mb-0">Shipping Date</dt>
                    <dd class="col-8 col-sm-9 mb-0">01/16/2024</dd>
                </dl>

                <button type="button" class="btn btn-primary w-100 rounded-pill mt-4">
                    Update Order Details
                </button>
            </div>

            <!-- ========================= ORDER SUMMARY ========================= -->
            <div class="col-lg-6">
                <h2 class="order-section-label">Order Summary</h2>

                <!-- TODO: bind order status -->
                <span class="badge rounded-pill text-bg-dark px-3 py-2 mb-4">
                    <i class="bi bi-info-circle me-1"></i> Pending
                </span>

                <!-- TODO: replace this sample line with the order details loop -->
                <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                    <div>
                        <p class="fw-semibold mb-0">Product Name</p>
                        <small class="text-secondary">$99.99 &times; 2</small>
                    </div>
                    <span class="fw-semibold text-primary">$199.98</span>
                </div>
                <!-- ====================== END DETAILS PLACEHOLDER ====================== -->

                <div class="order-total d-flex justify-content-between align-items-center rounded-3 px-4 py-3 my-4">
                    <span class="text-uppercase small fw-semibold">Total</span>
                    <!-- TODO: bind order total -->
                    <span class="fs-4 fw-bold">$199.98</span>
                </div>

                <div class="d-grid gap-2">
                    <button type="button" class="btn btn-primary rounded-pill">
                        Start Processing
                    </button>
                    <button type="button" class="btn btn-primary rounded-pill">
                        Ship Order
                    </button>
                    <button type="button" class="btn btn-danger rounded-pill">
                        Cancel Order
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
