<div class="cart-panel-header d-flex justify-content-between align-items-center rounded-4 px-4 py-3 mb-4">
    <div class="d-flex align-items-center gap-3">
        <i class="bi bi-grid fs-2"></i>
        <div>
            <h1 class="h4 fw-bold mb-0">Product List</h1>
            <p class="mb-0 small text-warning">Manage products</p>
        </div>
    </div>
    <a asp-controller="Product" asp-action="Upsert" class="btn btn-primary rounded-pill px-4 shadow-sm" style="height: fit-content">
        <i class="bi bi-plus-circle me-1"></i> New Product
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="tblData" class="table table-hover align-middle mb-0">
                <thead class="text-uppercase small text-muted">
                    <tr>
                        <th class="ps-4 py-3" scope="col">Product Name</th>
                        <th class="ps-4 py-3" scope="col">ISBN</th>
                        <th class="ps-4 py-3" scope="col">Price</th>
                        <th class="ps-4 py-3" scope="col">Author</th>
                        <th class="ps-4 py-3" scope="col">Category</th>
                        <th class="pe-4 py-3 text-end" scope="col">Actions</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/products.js" asp-append-version="true"></script>
}
