<!-- ============================ NEWSLETTER ============================ -->
<section class="newsletter-section rounded-4 p-4 p-md-5 text-center">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <i class="bi bi-envelope-heart display-5 text-white"></i>
            <h2 class="fw-bold text-white mt-3 mb-2">Stay Updated</h2>
            <p class="lead text-white-50 mb-4">
                Subscribe to get special offers, free giveaways, and exclusive deals.
            </p>
            <form class="row g-2 justify-content-center">
                <div class="col-md-6">
                    <input type="email" name="email" class="form-control form-control-lg rounded-pill px-4"
                           placeholder="Your email address" aria-label="Email address" required />
                </div>
                <div class="col-md-auto">
                    <button type="submit" class="btn btn-warning btn-lg fw-semibold rounded-pill px-4 text-dark">
                        Subscribe
                    </button>
                </div>
            </form>
            <p class="small text-white-50 mt-3 mb-0">
                <i class="bi bi-shield-check me-1"></i> We respect your privacy
            </p>
        </div>
    </div>
</section>