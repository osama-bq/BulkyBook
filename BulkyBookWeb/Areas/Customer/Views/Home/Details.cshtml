@using BulkyBook.Models
@model ShoppingCart
@{
    ViewData["Title"] = "Book Details";
}

<div class="mb-3">
    <a asp-action="Index" class="text-decoration-none text-secondary small fw-medium d-inline-flex align-items-center gap-1">
        <i class="bi bi-arrow-left"></i> Back to all books
    </a>
</div>

<form method="post">
    <input hidden asp-for="ProductId" />
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="row g-0">

            <!-- Cover -->
            <div class="col-lg-5 details-cover d-flex align-items-center justify-content-center">
                @if (!string.IsNullOrEmpty(Model.Product.ImageUrl))
                {
                    <img src="@Model.Product.ImageUrl" alt="Book cover"/>
                }
                else
                {
                    <i class="bi bi-image"></i>
                }
            </div>

            <!-- Details -->
            <div class="col-lg-7 p-4 p-lg-5">
                <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis mb-3">
                    <i class="bi bi-bookmark me-1"></i> @Model.Product.Category.Name
                </span>

                <h1 class="h3 fw-bold mb-1">@Model.Product.Title</h1>
                <p class="text-secondary mb-2">
                    by <span class="fw-medium text-dark">@Model.Product.Author</span>
                </p>
                <p class="text-secondary small mb-4">ISBN: @Model.Product.ISBN</p>

                <div class="d-flex align-items-baseline gap-2 mb-4">
                    <span class="h3 fw-bold text-primary mb-0">@Model.Product.Price100.ToString("c")</span>
                    <span class="text-decoration-line-through text-secondary">@Model.Product.ListPrice.ToString("c")</span>
                </div>

                <!-- Volume discounts -->
                <div class="border rounded-4 p-3 mb-4 bg-body-tertiary">
                    <p class="text-uppercase fw-bold text-secondary mb-3" style="font-size: 0.65rem; letter-spacing: 0.1em;">
                        <i class="bi bi-stack me-1 text-primary"></i> Volume Discounts
                    </p>
                    <div class="row g-2 text-center">
                        <div class="col-4">
                            <div class="bg-white border rounded-3 p-2 shadow-sm h-100 d-flex flex-column align-items-center justify-content-center">
                                <p class="text-uppercase text-secondary mb-1" style="font-size: 0.6rem; font-weight: 700;">1-50 Units</p>
                                <p class="fw-bold mb-0 text-primary">@Model.Product.Price.ToString("c")</p>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="bg-white border rounded-3 p-2 shadow-sm h-100 d-flex flex-column align-items-center justify-content-center">
                                <p class="text-uppercase text-secondary mb-1" style="font-size: 0.6rem; font-weight: 700;">51-100 Units</p>
                                <p class="fw-bold mb-0 text-primary">@Model.Product.Price50.ToString("c")</p>
                                <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis mt-1" style="font-size: 0.55rem;">SAVE</span>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="border border-primary bg-primary-subtle rounded-3 p-2 shadow-sm h-100 d-flex flex-column align-items-center justify-content-center">
                                <p class="text-uppercase text-secondary mb-1" style="font-size: 0.6rem; font-weight: 700;">100+ Units</p>
                                <p class="fw-bold mb-0 text-primary">@Model.Product.Price100.ToString("c")</p>
                                <span class="badge rounded-pill bg-primary text-white mt-1" style="font-size: 0.55rem;">BEST</span>
                            </div>
                        </div>
                    </div>
                </div>

                <p class="text-secondary small mb-4">
                    @Model.Product.Description
                </p>

                <div class="d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center gap-2">
                    <div class="input-group flex-shrink-0" style="max-width: 140px;">
                        <span class="input-group-text fw-semibold small bg-primary text-white border-primary">Qty</span>
                        <input asp-for="Count" type="number" class="form-control text-center fw-medium" min="1"
                               aria-label="Quantity"/>
                    </div>
                    <button type="submit" class="btn btn-primary flex-grow-1 fw-semibold py-2 rounded-pill">
                        <i class="bi bi-cart-plus me-1"></i> Add to Cart
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>
