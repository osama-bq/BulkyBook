@using BulkyBook.Models
@model Category

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <h1 class="fw-bold mb-0">
        Delete Category
    </h1>
    <a asp-controller="Category" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
        <i class="bi bi-arrow-left me-1"></i> Back to List
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4">
        <form method="post" asp-controller="Category" asp-action="Delete">
            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-medium">Category Name</label>
                <input readonly disabled name="Name" asp-for="Name" class="form-control" placeholder="e.g. Fiction" />
            </div>

            <div class="mb-4">
                <label asp-for="DisplayOrder" class="form-label fw-medium">Display Order</label>
                <input readonly disabled type="number" name="DisplayOrder" asp-for="DisplayOrder" class="form-control"
                       placeholder="e.g. 1" />
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-controller="Category" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                    Cancel
                </a>
                <button type="submit" class="btn btn-danger rounded-pill px-4">
                    <i class="bi bi-check-lg me-1"></i> Delete
                </button>
            </div>
        </form>
    </div>
</div>
